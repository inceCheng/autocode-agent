DASHSCOPE_API_KEY=your-dashscope-api-key-here
APP_NAME=ai-agent-assistant-platform
APP_DEBUG=false

# ==================== HTML代码生成模型配置 ====================
# 大模型API密钥（此处复用DashScope密钥，也可替换为其他OpenAI兼容服务密钥）
HTML_CODEGEN_API_KEY=your-api-key-here
# 大模型API基础URL
HTML_CODEGEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 大模型名称
HTML_CODEGEN_MODEL_NAME=qwen3.5-flash
# 生成温度参数（0.0~1.0，越高越有创造性）
HTML_CODEGEN_TEMPERATURE=0.7

# ==================== HTML代码生成输出配置 ====================
# 生成的HTML文件保存目录
HTML_OUTPUT_DIR=./output/html
# 系统提示词文件路径
HTML_SYSTEM_PROMPT_PATH=app/prompts/codegen-html-system-prompt.txt

# ==================== 多文件代码生成模型配置 ====================
# 大模型API密钥（留空则复用HTML_CODEGEN_API_KEY）
MULTI_FILE_CODEGEN_API_KEY=
# 大模型API基础URL
MULTI_FILE_CODEGEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 大模型名称
MULTI_FILE_CODEGEN_MODEL_NAME=qwen3.5-flash
# 生成温度参数（0.0~1.0）
MULTI_FILE_CODEGEN_TEMPERATURE=0.7

# ==================== 多文件代码生成输出配置 ====================
# 生成的多文件项目保存目录
MULTI_FILE_OUTPUT_DIR=./output/multi_file
# 系统提示词文件路径
MULTI_FILE_SYSTEM_PROMPT_PATH=app/prompts/codegen-multi-file-system-prompt.txt

# ==================== Vue工程项目生成模型配置 ====================
# 大模型API密钥（留空则复用HTML_CODEGEN_API_KEY）
VUE_PROJECT_CODEGEN_API_KEY=
# 大模型API基础URL
VUE_PROJECT_CODEGEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 大模型名称（需支持Tool Calling）
VUE_PROJECT_CODEGEN_MODEL_NAME=qwen-plus
# 生成温度参数（0.0~1.0）
VUE_PROJECT_CODEGEN_TEMPERATURE=0.7

# ==================== Vue工程项目生成输出配置 ====================
# 生成的Vue工程项目保存目录
VUE_PROJECT_OUTPUT_DIR=./output/vue_project
# 系统提示词文件路径
VUE_PROJECT_SYSTEM_PROMPT_PATH=app/prompts/codegen-vue-project-system-prompt.txt

# ==================== Kafka 配置 ====================
# Kafka 集群地址（多个用逗号分隔）
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Kafka 消费的 Topic 名称（与Java后端保持一致）
KAFKA_TOPIC=agent-generation-tasks
# Kafka 消费者组ID
KAFKA_CONSUMER_GROUP=agent-code-platform-worker

# ==================== Redis 配置 ====================
# Redis 服务器地址
REDIS_HOST=localhost
# Redis 服务器端口
REDIS_PORT=6379
# Redis 密码（无密码留空）
REDIS_PASSWORD=
# Redis 数据库编号
REDIS_DB=0
# 任务历史过期时间（秒）
REDIS_TASK_HISTORY_TTL=3600

# ==================== 对话标题生成模型配置 ====================
# 大模型API密钥（留空则复用HTML_CODEGEN_API_KEY）
TITLE_GEN_API_KEY=
# 大模型API基础URL
TITLE_GEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 大模型名称
TITLE_GEN_MODEL_NAME=qwen3.5-flash
# 生成温度参数（保持低位以保证标题稳定性）
TITLE_GEN_TEMPERATURE=0.1
# 系统提示词文件路径
TITLE_GEN_SYSTEM_PROMPT_PATH=app/prompts/title-gen-system-prompt.txt

# ==================== JWT 配置 ====================
# Base64编码的JWT密钥，必须与Java后端 jwt.secret 保持一致
JWT_SECRET=EnterpriseLevelSpringbootJwtSecretKeyThatIsAtLeast256BitsLong==
# JWT签名算法
JWT_ALGORITHM=HS256
