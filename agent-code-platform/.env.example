DASHSCOPE_API_KEY=your-dashscope-api-key-here
APP_NAME=ai-agent-assistant-platform
APP_DEBUG=false

# ==================== HTML代码生成模型配置 ====================
# 大模型API密钥（此处复用DashScope密钥，也可替换为其他OpenAI兼容服务密钥）
HTML_CODEGEN_API_KEY=your-api-key-here
# 大模型API基础URL
HTML_CODEGEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 大模型名称
HTML_CODEGEN_MODEL_NAME=qwen3.5-flash
# 生成温度参数（0.0~1.0，越高越有创造性）
HTML_CODEGEN_TEMPERATURE=0.7

# ==================== HTML代码生成输出配置 ====================
# 生成的HTML文件保存目录
HTML_OUTPUT_DIR=./output/html
# 系统提示词文件路径
HTML_SYSTEM_PROMPT_PATH=app/prompts/codegen-html-system-prompt.txt

# ==================== Kafka 配置 ====================
# Kafka 集群地址（多个用逗号分隔）
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Kafka 消费的 Topic 名称（与Java后端保持一致）
KAFKA_TOPIC=agent-generation-tasks
# Kafka 消费者组ID
KAFKA_CONSUMER_GROUP=agent-code-platform-worker

# ==================== Redis 配置 ====================
# Redis 服务器地址
REDIS_HOST=localhost
# Redis 服务器端口
REDIS_PORT=6379
# Redis 密码（无密码留空）
REDIS_PASSWORD=
# Redis 数据库编号
REDIS_DB=0
# 任务历史过期时间（秒）
REDIS_TASK_HISTORY_TTL=3600

# ==================== JWT 配置 ====================
# Base64编码的JWT密钥，必须与Java后端 jwt.secret 保持一致
JWT_SECRET=EnterpriseLevelSpringbootJwtSecretKeyThatIsAtLeast256BitsLong==
# JWT签名算法
JWT_ALGORITHM=HS256
